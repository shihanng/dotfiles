{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
{{- if eq .chezmoi.username "shi-han.ng" }}
  "provider": {
      "anthropic": {
          "options": {
              "baseURL": "{{- onepasswordRead "op://Personal/LiteLLM/hostname" -}}/v1",
              "apiKey": "{{- onepasswordRead "op://Personal/LiteLLM/credential" -}}"
          },
          "models": {
              "claude-haiku-4-5-20251001": {
                  "options": {
                    "toolStreaming": false
                  }
              },
              "claude-opus-4-8": {
                  "options": {
                    "toolStreaming": false,
                    "thinking": { "type": "adaptive" },
                    "output_config": { "effort": "xhigh" }
                  }
              },
              "claude-sonnet-4-6": {
                  "options": {
                    "toolStreaming": false,
                    "thinking": { "type": "adaptive" },
                    "output_config": { "effort": "high" }
                  }
              },
              "claude-sonnet-5": {
                  "options": {
                    "toolStreaming": false,
                    "thinking": { "type": "adaptive" },
                    "output_config": { "effort": "xhigh" }
                  }
              },
              "claude-opus-5": {
                  "options": {
                    "toolStreaming": false,
                    "thinking": { "type": "adaptive" },
                    "output_config": { "effort": "xhigh" }
                  }
              }
          }
      },
      "google": {
          "options": {
              "baseURL": "{{- onepasswordRead "op://Personal/LiteLLM/hostname" -}}/v1beta",
              "apiKey": "{{- onepasswordRead "op://Personal/LiteLLM/credential" -}}"
          },
          "models": {
              "gemini-3.5-flash": {},
              "gemini-3.1-pro-preview": {}
          }
      },
      "openai": {
          "options": {
              "baseURL": "{{- onepasswordRead "op://Personal/LiteLLM/hostname" -}}/v1",
              "apiKey": "{{- onepasswordRead "op://Personal/LiteLLM/credential" -}}"
          },
          "models": {
              "gpt-5.5-pro": {},
              "gpt-5.6-terra": {},
              "gpt-5.6-luna": {},
              "gpt-5.6-sol": {}
          }
      }
  },
  "model": "anthropic/claude-sonnet-5",
  "permission": {
    "nvim_*": "allow"
  },
  "agent": {
      "plan": {
          "model": "anthropic/claude-sonnet-5"
      },
      "build": {
          "model": "anthropic/claude-sonnet-5"
      },
      "general": {
          "model": "anthropic/claude-sonnet-5"
      },
      "explore": {
          "model": "anthropic/claude-haiku-4-5-20251001"
      },
      "code-reviewer": {
          "model": "anthropic/claude-opus-4-8"
      },
      "commit-author": {
          "model": "anthropic/claude-haiku-4-5-20251001"
      },
      "content-proofreader": {
          "model": "anthropic/claude-haiku-4-5-20251001",
          "temperature": 0.2
      },
      "compaction": {
          "model": "anthropic/claude-sonnet-5"
      },
      "title": {
          "model": "anthropic/claude-haiku-4-5-20251001"
      },
      "summary": {
          "model": "anthropic/claude-haiku-4-5-20251001"
      }
  },
  {{ else }}
  "model": "github-copilot/claude-sonnet-4.6",
  "agent": {
    "plan": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "build": {
      "model": "github-copilot/claude-sonnet-4.6"
    }
  },
  {{ end -}}
  {{- if lookPath "hunk" }}
  "skills": {
    "paths": ["{{ output "hunk" "skill" "path" | trim | dir | dir }}"]
  },
  {{- end }}
  "default_agent": "plan",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["mcp-server-memory"],
      "enabled": false,
      "environment": {
        "MEMORY_FILE_PATH": "~/memory.json"
      }
    },
    "vectorcode-mcp-server": {
      "type": "local",
      "command": ["vectorcode-mcp-server"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["context7-mcp"],
      "enabled": true
    },
    "astro_doc": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["shadcn", "mcp"],
      "enabled": false
    },
    "opentofu": {
      "type": "local",
      "command": ["opentofu-mcp-server"],
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["mcp-server-sequential-thinking"],
      "enabled": true
    },
    "dbhub-postgres-npx": {
      "type": "local",
      "command": [
        "dbhub",
        "--transport",
        "stdio",
        "--dsn",
        "postgres://postgres@localhost:5432/postgres?sslmode=disable"
      ],
      "enabled": false
    },
    "chrome": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--no-usage-statistics",
        "--isolated",
        "--headless"
      ],
      "enabled": false
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": false
    },
    "nvim": {
      "type": "local",
      "command": [
        "nvim-mcp",
        "--connect",
        "auto"
      ],
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "zuban": {
      "command": ["zuban", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
