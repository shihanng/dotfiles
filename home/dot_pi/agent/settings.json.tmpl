{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
{{- if eq .chezmoi.username "shi-han.ng" }}
  "defaultProvider": "litellm",
  "defaultModel": "claude-sonnet-5",
  "enabledModels": [
    "litellm/claude-sonnet-5",
    "litellm/claude-opus-5",
    "litellm/gpt-5.6-terra",
    "litellm/gemini-3.7-flash",
    "claude-haiku-4-5-20251001",
    "openai/gpt-6-astra"
  ],
{{- else }}
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "enabledModels": [
    "openai/gpt-5.6-terra",
    "openai/gpt-5.6-luna",
    "openai/gpt-5.6-sol"
  ],
{{- end }}
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "skills": [
{{- if lookPath "hunk" }}
    "{{ output "hunk" "skill" "path" | trim | dir | dir }}",
{{- end }}
    "~/dev/me/github.com/shihanng/secret-skills/skills"
  ],
  "packages": [
    "npm:pi-provider-litellm",
    "npm:pi-nvim",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:@narumitw/pi-btw"
  ]
}
